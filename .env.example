# Separate MongoDB — local mongod, Coolify Mongo service, or Atlas (not in this repo)
DATABASE_URI=mongodb://127.0.0.1:27017/payload-3rd

# Required by Payload — use a long random string in production
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public app URL (Coolify domain in production)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
